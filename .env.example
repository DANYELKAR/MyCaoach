# Copy to .env ONLY for compose.supabase.yaml; never commit real values.
# Copy host/username from Supabase Connect > Session pooler > JDBC.
# DATABASE_URL is a JDBC URL, not postgres://. Keep the password in its own field.
DATABASE_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Used by later storage/auth-admin phase. Backend only.
SUPABASE_SERVICE_KEY=
# Used by later generation/billing phases; not yet wired into application code.
GEMINI_API_KEY=
GEMINI_MODEL=
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Optional legacy Supabase projects only. Prefer asymmetric JWKS.
SUPABASE_LEGACY_HS256_ENABLED=false
SUPABASE_JWT_SECRET=
# Optional diagnostics; defaults to false outside the local profile.
API_DOCS_ENABLED=false
